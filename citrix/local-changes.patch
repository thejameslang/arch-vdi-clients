From c0d9d7b8d24fa79b217037595938dc445b698085 Mon Sep 17 00:00:00 2001
From: thejameslang <7258460+thejameslang@users.noreply.github.com>
Date: Sat, 14 Nov 2026 08:44:58 -0600
Subject: [PATCH 1/4] local: bump to 26.08.0.225 (Citrix-published sha256), add
 NetScaler EPA

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 PKGBUILD | 62 +++++++++++++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 59 insertions(+), 3 deletions(-)

diff --git a/PKGBUILD b/PKGBUILD
index b23f461..3d10225 100644
--- a/PKGBUILD
+++ b/PKGBUILD
@@ -7,7 +7,7 @@
 # Contributor: Giorgio Azzinnaro <giorgio@azzinna.ro>
 
 pkgname=icaclient
-pkgver=26.04.10.1
+pkgver=26.08.0.225
 pkgrel=1
 pkgdesc="Citrix Workspace App (a.k.a. ICAClient, Citrix Receiver)"
 arch=(x86_64 aarch64)
@@ -16,6 +16,8 @@ license=(LicenseRef-Citrix)
 depends=(alsa-lib curl gst-plugins-base-libs libc++ libc++abi
          libsecret libvorbis libxaw libxml2-legacy libxp
          openssl speex)
+# local addition: NetScaler Gateway Endpoint Analysis (EPA), x86_64 only
+depends_x86_64=(gpgme gtk3 libnotify libproxy pugixml)
 optdepends=('webkit2gtk: provides libwebkit2gtk-4.0 ABI; required for selfservice and the wfica connection dialog'
             'libsoup: provides libsoup-2.4 ABI; required for selfservice and the wfica connection dialog')
 conflicts=('bin32-citrix-client' 'citrix-client')
@@ -45,10 +47,58 @@ sha256sums=('643427b6e04fc47cd7d514af2c2349948d3b45f536c434ba8682dcb1d4314736'
             'a3bd74aaf19123cc550cde71b5870d7dacf9883b7e7a85c90e03b508426c16c4'
             '0e3a6c7cf7fa9eee7dcde7356e90ffa1cb312bffc0813a0bf123d2f918dc369d'
             '739da3fca95d07fc3076522acc6b6c1b12b988047bd2fb3c87e37231e49f2e1f')
-sha256sums_x86_64=('8c0a22cad4a4cda802cb5d3bb09b89779d20f68ba5e454b86485354c557356b5')
-sha256sums_aarch64=('4e65c1d449a2a9f21905135cc02418fbe434bc23705cad26dbe81ef4b3b9bd54')
+sha256sums_x86_64=('4231d4c2550656f89ca05b53d70543391dbf7a0c18bc44b4f85184758c5cbaa0')
+sha256sums_aarch64=('bbcf1e8c76b655c4f9d46ec72b62de1c7fc4f8d7222f40fb57928092afb1c7c3')
 install=citrix-client.install
 
+# Local addition. Mirrors what Citrix's hinst/nsepa .deb do, minus the parts that
+# don't belong in a package: no symlink in /usr/lib (the libgpgme.so.11 compat
+# link lives in a private dir used via a wrapper), no world-writable desktop file,
+# nothing in /usr/local, and startnsgcepa.sh (root script that su's into every
+# logged-in user) is not installed. The browser starts EPA via nsgcepa:// links.
+_package_epa() {
+    local epatmp="$srcdir/epa"
+    local dst="${pkgdir}/opt/Citrix/Browser-EPA"
+    local src="$epatmp/epadebianpkg/opt/Citrix/Browser-EPA"
+
+    rm -rf "$epatmp"
+    mkdir -p "$epatmp"
+    tar -xf "$ICADIR"/EPA/linuxvpn-*.tar -C "$epatmp" nsepa.tar.gz
+    tar -xzf "$epatmp/nsepa.tar.gz" -C "$epatmp"
+
+    install -d "$dst"
+    install -m755 "$src/nsgcepa" "$dst/"
+    install -m644 -t "$dst" "$src"/*.so "$src"/LinuxClientLibrary.so.sig \
+            "$src"/version.json "$src"/minversion.txt "$src"/releaseversion.txt \
+            "$src"/nsgcepa.desktop
+    install -m444 "$src/pubkey.asc" "$dst/"
+
+    # nsgcepa links against libgpgme.so.11; Arch ships gpgme 2.x with the same
+    # versioned symbols (GPGME_1.0/1.1) under a newer SONAME.
+    install -d "$dst/compat"
+    ln -s /usr/lib/libgpgme.so "$dst/compat/libgpgme.so.11"
+
+    install -d "${pkgdir}/usr/bin"
+    cat > "${pkgdir}/usr/bin/nsgcepa" <<'EOF'
+#!/bin/sh
+LD_LIBRARY_PATH="/opt/Citrix/Browser-EPA/compat${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+export LD_LIBRARY_PATH
+exec /opt/Citrix/Browser-EPA/nsgcepa "$@"
+EOF
+    chmod 755 "${pkgdir}/usr/bin/nsgcepa"
+
+    # URL handler for nsgcepa:// links opened by the NetScaler Gateway login page
+    sed -e 's|^Exec=.*|Exec=/usr/bin/nsgcepa %u|' \
+        -e 's|^Name=.*|Name=Citrix Endpoint Analysis|' \
+        -e 's|^Terminal=False|Terminal=false|' \
+        -e 's|^Categories=.*|Categories=Network;|' \
+        -e '/^Icon=$/d' \
+        -e '/^Version=/d' \
+        -e '$a NoDisplay=true' \
+        "$src/nsgcepa.desktop" > "$epatmp/nsgcepa.desktop"
+    install -Dm644 "$epatmp/nsgcepa.desktop" "${pkgdir}/usr/share/applications/nsgcepa.desktop"
+}
+
 package() {
     cd "${srcdir}"
     ICAROOT=/opt/Citrix/ICAClient
@@ -124,6 +174,12 @@ package() {
         chmod +x "${pkgdir}$ICAROOT"/util/HdxRtcEngine
     fi
 
+    # local addition: NetScaler Gateway Endpoint Analysis (EPA)
+    if [[ $CARCH == 'x86_64' ]]
+    then
+        _package_epa
+    fi
+
     # install systemd unit files
     install -Dm755 -t "${pkgdir}/usr/lib/systemd/system" "ctxcwalogd.service"
     install -Dm755 -t "${pkgdir}/usr/lib/systemd/system" "ctxusbd.service"
-- 
2.56.1


From 6c4b248274de467f69cc2722deda4c6f4d9aa959 Mon Sep 17 00:00:00 2001
From: thejameslang <7258460+thejameslang@users.noreply.github.com>
Date: Sat, 14 Nov 2026 18:52:31 -0600
Subject: [PATCH 2/4] local: register Citrix URL/file handlers, depend on
 webkit2gtk-4.1

Adds the handlers Citrix's hinst installs (receiver://, citrixauthwebviewdone://,
ctxlinuxamloauth://, ctxaadsso://, citrixweb:// -> ctxwebhelper; citrixapp:// ->
selfservice; .cr -> new_store) and the .ica/.cr MIME definitions.
26.08 selfservice links libwebkit2gtk-4.1, so depend on it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 PKGBUILD | 47 ++++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 44 insertions(+), 3 deletions(-)

diff --git a/PKGBUILD b/PKGBUILD
index 3d10225..2d77732 100644
--- a/PKGBUILD
+++ b/PKGBUILD
@@ -8,7 +8,7 @@
 
 pkgname=icaclient
 pkgver=26.08.0.225
-pkgrel=1
+pkgrel=2
 pkgdesc="Citrix Workspace App (a.k.a. ICAClient, Citrix Receiver)"
 arch=(x86_64 aarch64)
 url='https://www.citrix.com/downloads/workspace-app/linux/workspace-app-for-linux-latest.html'
@@ -18,8 +18,8 @@ depends=(alsa-lib curl gst-plugins-base-libs libc++ libc++abi
          openssl speex)
 # local addition: NetScaler Gateway Endpoint Analysis (EPA), x86_64 only
 depends_x86_64=(gpgme gtk3 libnotify libproxy pugixml)
-optdepends=('webkit2gtk: provides libwebkit2gtk-4.0 ABI; required for selfservice and the wfica connection dialog'
-            'libsoup: provides libsoup-2.4 ABI; required for selfservice and the wfica connection dialog')
+# local change: 26.08's selfservice links libwebkit2gtk-4.1 (in extra), not 4.0
+depends+=(webkit2gtk-4.1)
 conflicts=('bin32-citrix-client' 'citrix-client')
 options=(!strip)
 backup=('opt/Citrix/ICAClient/config/appsrv.ini'
@@ -99,6 +99,45 @@ EOF
     install -Dm644 "$epatmp/nsgcepa.desktop" "${pkgdir}/usr/share/applications/nsgcepa.desktop"
 }
 
+# Local addition. The same handlers hinst's DT_create_files writes (same Exec
+# lines), generated cleanly instead of copying its files (which have
+# "Exec= " with a leading space and the deprecated Encoding key).
+#   receiver://, citrixauthwebviewdone://, ctxlinuxamloauth://, ctxaadsso://,
+#   citrixweb://  -> util/ctxwebhelper   (sign-in callbacks, web portal detection)
+#   citrixapp://  -> selfservice
+#   .cr store configuration files -> util/new_store
+_package_handlers() {
+    local apps="${pkgdir}/usr/share/applications" ica=/opt/Citrix/ICAClient
+    local name scheme exec
+    install -d "$apps"
+    while read -r name scheme exec; do
+        cat > "$apps/citrix-$name.desktop" <<EOF
+[Desktop Entry]
+Type=Application
+Name=Citrix Workspace Launcher
+Exec=$exec
+TryExec=${exec%% *}
+Icon=$ica/icons/receiver.png
+NoDisplay=true
+StartupWMClass=Wfica
+Categories=Network;
+MimeType=$scheme;
+EOF
+    done <<EOF
+receiver x-scheme-handler/receiver $ica/util/ctxwebhelper %u
+receiver-fido2 x-scheme-handler/citrixauthwebviewdone $ica/util/ctxwebhelper %u
+fido2-llt x-scheme-handler/ctxlinuxamloauth $ica/util/ctxwebhelper %u
+ctxaadsso x-scheme-handler/ctxaadsso $ica/util/ctxwebhelper %u
+citrixweb x-scheme-handler/citrixweb $ica/util/ctxwebhelper %u
+citrixapp x-scheme-handler/citrixapp $ica/selfservice %u
+new-store application/vnd.citrix.receiver.configure $ica/util/new_store -icaroot $ica %f
+EOF
+    sed -i 's/^Name=.*/Name=Add Citrix Store/' "$apps/citrix-new-store.desktop"
+    # .ica and .cr MIME type definitions
+    install -Dm644 "$ICADIR/desktop/Citrix-mime_types.xml" \
+        "${pkgdir}/usr/share/mime/packages/citrix-mime_types.xml"
+}
+
 package() {
     cd "${srcdir}"
     ICAROOT=/opt/Citrix/ICAClient
@@ -165,6 +204,8 @@ package() {
     cd "${srcdir}"
     # install freedesktop.org files
     install -Dm644 -t "$pkgdir"/usr/share/applications citrix-{configmgr,conncenter,workspace,wfica}.desktop
+    # local addition: URL/file handlers Citrix's installer (hinst) registers
+    _package_handlers
     # install scripts
     install -Dm755 -t "${pkgdir}$ICAROOT" wfica.sh wfica_assoc.sh
 
-- 
2.56.1


