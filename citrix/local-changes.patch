From 692724c473a436f78313a3447268ca5cce3af717 Mon Sep 17 00:00:00 2001
From: thejameslang <7258460+thejameslang@users.noreply.github.com>
Date: Tue, 17 Nov 2026 21:00:47 -0600
Subject: [PATCH 5/5] local: run Citrix with GDK_BACKEND=x11

Citrix's auth helpers call X11 directly (gdk_x11_*, XSendEvent). With GTK
on Wayland (Omarchy sets GDK_BACKEND=wayland,x11,*), PrimaryAuthManager
segfaults at address 0 when the sign-in window opens. Set GDK_BACKEND=x11
in every launcher, URL/file handler and wrapper; child processes inherit it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .SRCINFO                  | 34 +++++++++++++++++++---------------
 PKGBUILD                  | 21 ++++++++++++++-------
 citrix-configmgr.desktop  |  2 +-
 citrix-conncenter.desktop |  2 +-
 citrix-workspace.desktop  |  2 +-
 wfica.sh                  |  2 ++
 wfica_assoc.sh            |  2 ++
 7 files changed, 40 insertions(+), 25 deletions(-)

diff --git a/.SRCINFO b/.SRCINFO
index 9edc41b..04f1a12 100644
--- a/.SRCINFO
+++ b/.SRCINFO
@@ -1,7 +1,7 @@
 pkgbase = icaclient
 	pkgdesc = Citrix Workspace App (a.k.a. ICAClient, Citrix Receiver)
-	pkgver = 26.04.10.1
-	pkgrel = 1
+	pkgver = 26.08.0.225
+	pkgrel = 5
 	url = https://www.citrix.com/downloads/workspace-app/linux/workspace-app-for-linux-latest.html
 	install = citrix-client.install
 	arch = x86_64
@@ -19,8 +19,7 @@ pkgbase = icaclient
 	depends = libxp
 	depends = openssl
 	depends = speex
-	optdepends = webkit2gtk: provides libwebkit2gtk-4.0 ABI; required for selfservice and the wfica connection dialog
-	optdepends = libsoup: provides libsoup-2.4 ABI; required for selfservice and the wfica connection dialog
+	depends = webkit2gtk-4.1
 	conflicts = bin32-citrix-client
 	conflicts = citrix-client
 	options = !strip
